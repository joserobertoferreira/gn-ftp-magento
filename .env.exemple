# Database connection parameters
DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PORT=
DB_SCHEMA=

# Application settings
DEBUG=True

# FTP connection parameters
SFTP_HOST=
SFTP_USER=
SFTP_PASSWORD=
SFTP_PORT=
SFTP_SYNC_BASE_PATH=

# Local export path for files
LOCAL_EXPORT_PATH=
LOCAL_IMPORT_PATH=
LOCAL_ARCHIVE_PATH=

# Email export path for files
EMAIL_ARCHIVE_PATH=

# Storage export path for files
STORAGE_ARCHIVE_PATH=

# Schedule configuration
SCHEDULE_ENABLED=False

# Execute immediately if the script is started within each task's time window
SCHEDULE_RUN_IMMEDIATELY=False

# File transfers to and from Magento: time window (HH:MM) and interval in minutes
SCHEDULE_START_TIME=06:00
SCHEDULE_END_TIME=20:00
# Execution interval in minutes
SCHEDULE_INTERVAL_MINUTES=5

# Stock synchronization: time window (HH:MM) and interval in minutes
STOCK_SCHEDULE_START_TIME=08:00
STOCK_SCHEDULE_END_TIME=23:00
# Execution interval in minutes
STOCK_SCHEDULE_INTERVAL_MINUTES=60

# Barcode extraction: time window (HH:MM) and interval in minutes (08:00, 12:00 and 16:00)
BARCODES_SCHEDULE_START_TIME=08:00
BARCODES_SCHEDULE_END_TIME=16:00
# Execution interval in minutes
BARCODES_SCHEDULE_INTERVAL_MINUTES=240

# Customer satisfaction emails file: daily execution time (HH:MM)
CUSTOMER_EMAILS_SCHEDULE_TIME=06:00